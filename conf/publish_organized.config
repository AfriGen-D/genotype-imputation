/*
 * Configure publishDir to use hierarchical structure:
 * dataset -> reference_panel -> {chunks, chromosome, genome, reports}
 */

process {
    // Chunk-level reports
    withName: 'FILTER_INFO_BY_TARGET|REPORT_WELL_IMPUTED|REPORT_ACCURACY|GENERATE_CHUNK_JSON' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}" },
            mode: 'copy',
            pattern: '*.{txt,tsv,json}'
        ]
    }
    
    // Chunk-level plots
    withName: 'PLOT_PERFORMANCE|PLOT_ACCURACY|PLOT_R2_MAF' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}/plots" },
            mode: 'copy',
            pattern: '*.{pdf,png}'
        ]
    }
    
    // Chromosome-level aggregation
    withName: 'AGGREGATE_CHUNKS_TO_CHR' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/chromosome" },
            mode: 'copy',
            pattern: '*.{json,txt}'
        ]
    }
    
    // Chromosome-level plots
    withName: 'PLOT_CHR_SUMMARY|PLOT_CHR_ALL_METRICS|PLOT_CHR_PERFORMANCE' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/chromosome/plots" },
            mode: 'copy',
            pattern: '*.{pdf,png}'
        ]
    }
    
    // Genome-level aggregation
    withName: 'AGGREGATE_CHR_TO_GENOME' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/genome" },
            mode: 'copy',
            pattern: '*.{json,txt}'
        ]
    }
    
    // Genome-level plots
    withName: 'PLOT_GENOME_SUMMARY|PLOT_GENOME_ALL_METRICS' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/genome/plots" },
            mode: 'copy',
            pattern: '*.{pdf,png}'
        ]
    }
    
    // Final reports (HTML/PDF)
    withName: 'GENERATE_DATASET_REPORT' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/reports" },
            mode: 'copy',
            pattern: '*.{html,pdf}'
        ]
    }
    
    // Frequency analysis outputs
    withName: 'EXTRACT_FREQ_IMPUTED|EXTRACT_FREQ_REFERENCE|MERGE_FREQ_COMPARISON' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}/frequency" },
            mode: 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }
    
    // Combined frequency analysis
    withName: 'COMBINE_FREQ_BY_CHR' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/chromosome/frequency" },
            mode: 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }
    
    withName: 'COMBINE_FREQ_GENOME' {
        publishDir = [
            path: { "${params.outdir}/${meta.dataset}/${ref_name}/genome/frequency" },
            mode: 'copy',
            pattern: '*.{tsv,txt}'
        ]
    }
    
    // Frequency comparison plots
    withName: 'PLOT_FREQ_COMPARISON' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}/plots" },
            mode: 'copy',
            pattern: '*.{pdf,png}'
        ]
    }
    
    // Average R2 reports
    withName: 'AVERAGE_R2' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}" },
            mode: 'copy',
            pattern: '*.{txt,tsv}'
        ]
    }
    
    // Warning collection
    withName: 'COLLECT_WARNINGS' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}/warnings" },
            mode: 'copy',
            pattern: '*.{txt,log}'
        ]
    }
    
    // Additional QC plots
    withName: 'PLOT_R2_SNPPOS|PLOT_R2_SNPCOUNT|PLOT_HIST_R2_SNPCOUNT|PLOT_MAF_R2' {
        publishDir = [
            path: { "${params.outdir}/${meta.sample ?: meta.id.split('_chr')[0]}/${ref_name}/chunks/chr${meta.contig ?: meta.id.split('chr')[1].split('_')[0]}/plots" },
            mode: 'copy',
            pattern: '*.{pdf,png}'
        ]
    }
}

// Helper function to create summary index files
def createIndexFiles = {
    // This would be called after pipeline completion to create index.html files
    // at each level for easy navigation
}