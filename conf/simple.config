/*
 * -------------------------------------------------
 *  Configuration for main_simple.nf pipeline
 * -------------------------------------------------
 * Default config options for running the pipeline
 */

params {
    // Project information
    project_name        = 'h3a_imputation'
    project_description = 'H3Africa genotype imputation pipeline'
    
    // Output directory
    outDir              = "output/${project_name}"
    
    // Reference data paths (CBIO cluster)
    eagle_genetic_map   = "/cbio/dbs/refpanels/eagle/tables/genetic_map_hg19_withX.txt.gz"
    reference_genome    = "/cbio/dbs/gatk/hg38/Homo_sapiens_assembly38.fasta"
    
    // Reference panels - H3Africa panels
    // Format: [name, m3vcf_path, vcf_path]
    ref_panels = [
        ['H3A_refpanel', 
         '/cbio/dbs/refpanels/H3A/m3vcf/chr%s.m3vcf.gz',
         '/cbio/dbs/refpanels/H3A/vcf/chr%s.vcf.gz'],
        ['1000G_phase3',
         '/cbio/dbs/refpanels/1000GP_Phase3/m3vcf/chr%s.1000g.Phase3.v5.With.Parameter.Estimates.m3vcf.gz',
         '/cbio/dbs/refpanels/1000GP_Phase3/vcf/chr%s.1000g.Phase3.v5.With.Parameter.Estimates.vcf.gz']
    ]
    
    // Processing parameters
    chromosomes         = 'ALL'  // Process all chromosomes
    chunk_size          = 20000000  // 20MB chunks
    buffer_size         = 1000000   // 1MB buffer
    
    // QC parameters
    site_miss          = 0.05
    hwe                = 0.00001
    mac                = 1
    min_ac             = 2
    min_alleles        = 2
    max_alleles        = 2
    maf_thresh         = 0.01
    
    // Phasing parameters
    phasing_method     = 'eagle'
    eagle_pbwt_iters   = 2
    
    // Imputation parameters
    impute_method      = 'minimac4'
    minRatio          = 0.01
    NE                = 20000
    impute_iter       = 10
    impute_burnin    = 2
    impute_info_cutoff = 0.3
    r2_threshold      = 0.3
    
    // Reporting
    qc_plots          = true
    
    // Resource limits
    max_memory        = '128.GB'
    max_cpus          = 16
    max_time          = '240.h'
}

// Process-specific resource requirements
process {
    // Default resources
    cpus   = 1
    memory = 4.GB
    time   = 4.h
    
    // Error strategy
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'
    
    // Process-specific resources
    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
        time   = 2.h
    }
    
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }
    
    withLabel: 'process_high' {
        cpus   = 8
        memory = 16.GB
        time   = 16.h
    }
    
    withLabel: 'process_long' {
        cpus   = 2
        memory = 8.GB
        time   = 48.h
    }
    
    withLabel: 'process_high_memory' {
        cpus   = 8
        memory = 64.GB
        time   = 24.h
    }
    
    // Specific process requirements
    withName: 'EAGLE_PHASING' {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }
    
    withName: 'IMPUTE_MINIMAC4' {
        cpus   = 4
        memory = 16.GB
        time   = 8.h
    }
    
    withName: 'CHECK_FILES' {
        cpus   = 1
        memory = 2.GB
        time   = 1.h
    }
    
    withName: 'GENERATE_CHUNKS_VCF' {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }
}

// Execution profiles
profiles {
    // Standard execution
    standard {
        process.executor = 'local'
    }
    
    // SLURM cluster execution
    slurm {
        process.executor = 'slurm'
        process.queue = 'Main'  // Use Main partition (default on this cluster)
        // process.clusterOptions = '--account=cbio'  // Uncomment if account is needed
    }
    
    // Singularity containers
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = './singularity_cache'
        
        process {
            container = 'mamana/imputation:minimac4-4.1.6'
            
            withLabel: 'bcftools' {
                container = 'mamana/vcf-processing:bcftools-1.20'
            }
            
            withLabel: 'phasing_eagle' {
                container = 'mamana/eagle-vcf-processing:eagle-2.4.1'
            }
            
            withLabel: 'impute_minimac4' {
                container = 'mamana/minimac4:minimac4-4.1.6'
            }
            
            withLabel: 'python_plotting' {
                container = 'mamana/python-plotting:1.0.0'
            }
        }
    }
    
    // Docker containers
    docker {
        docker.enabled = true
        docker.userEmulation = true
        
        process {
            container = 'h3abionet/imputation:latest'
            
            withLabel: 'bcftools' {
                container = 'biocontainers/bcftools:1.20'
            }
            
            withLabel: 'phasing_eagle' {
                container = 'h3abionet/eagle:2.4.1'
            }
            
            withLabel: 'impute_minimac4' {
                container = 'h3abionet/minimac4:4.1.6'
            }
            
            withLabel: 'python_plotting' {
                container = 'h3abionet/python-plotting:1.0.0'
            }
        }
    }
    
    // Test profile with small dataset
    test {
        params {
            input = 'test_sample.csv'
            outDir = 'test_output'
            chromosomes = '21,22'
            chunk_size = 5000000
            max_memory = '8.GB'
            max_cpus = 2
            max_time = '2.h'
        }
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline and report
timeline {
    enabled = true
    file = "${params.outDir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outDir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file = "${params.outDir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    file = "${params.outDir}/pipeline_info/dag.svg"
}

// Function to ensure work directories are writable
def checkWorkDir() {
    def workDir = workflow.workDir
    if (!workDir.canWrite()) {
        exit 1, "ERROR: Work directory ${workDir} is not writable"
    }
}

// Export functions
manifest {
    name = 'h3abionet/chipimputation'
    author = 'H3ABioNet Consortium'
    homePage = 'https://github.com/h3abionet/chipimputation'
    description = 'H3Africa genotype imputation pipeline'
    mainScript = 'main_simple.nf'
    nextflowVersion = '>=21.04.0'
    version = '1.0.0'
}