/*
 * -------------------------------------------------
 * h3achipimputation Nextflow base config file
 * -------------------------------------------------
 * A 'blank slate' config file, appropriate for general
 * use on most high performace compute environments.
 * Assumes that all software is installed and available
 * on the PATH. Runs in `local` mode - all jobs will be
 * run on the logged in environment.
 */

process {
  // Default resource requirements for all processes
  cpus = 1
  memory = 4.GB
  time = 4.h

  stageOutMode = 'rsync'

  // Default error handling
  errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  maxRetries = 0
  maxErrors = '-1'

  // Process-specific resource requirements based on task labels
  withLabel: 'small' {
    cpus = 1
    memory = 2.GB
    time = 2.h
  }

  withLabel: 'medium' {
    cpus = 2
    memory = 8.GB
    time = 8.h
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  }

  withLabel: 'bigmem' {
    cpus = 4
    memory = 16.GB
    time = 12.h
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
  }

  // Process-specific resource allocation by process name
  withName: 'IMPUTE_MINIMAC4' {
    cpus = 4
    memory = 32.GB
    time = 24.h
  }

  withName: 'EAGLE_PHASING' {
    cpus = 2
    memory = 16.GB
    time = 12.h
  }

  withName: 'GENERATE_CHUNKS_VCF|SPLIT_TARGET_TO_CHUNK' {
    cpus = 1
    memory = 4.GB
    time = 1.h
  }

  withName: 'REPORT_.*|FILTER_INFO_BY_TARGET' {
    cpus = 1
    memory = 4.GB
    time = 2.h
  }

  withName: 'PLOT_.*' {
    cpus = 1
    memory = 4.GB
    time = 2.h
  }

  withName: 'TARGET_QC|QC_SITE_MISSINGNESS' {
    cpus = 2
    memory = 8.GB
    time = 4.h
  }
}

params {
  // Default maximum resources - can be overridden in profiles
  max_memory = 128.GB
  max_cpus = 16
  max_time = 240.h
}

