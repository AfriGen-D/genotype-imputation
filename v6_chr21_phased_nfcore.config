/*
 * -------------------------------------------------
 *  Nextflow config file for v6 chr21/22 phased imputation - nf-core style
 * -------------------------------------------------
 * Configuration for imputing v6 phased data with H3Africa reference panels
 * Uses CSV samplesheet input instead of target_datasets
 * Compatible with main_nfcore.nf
 */

// Set work directory to scratch for better performance
workDir = '/scratch3/users/mamana/nextflow-work'

params {
  // Project information
  project_name            = 'v6_chr21_phased_imputation_nfcore'
  project_description     = 'Imputation test using v6 chr21/22 phased data with CSV input'
  outdir                  = "/scratch3/users/mamana/results"  // Hardcoded base path for all outputs
  help                    = false
  version                 = '1.0.0'
  
  // Input - using CSV samplesheet instead of target_datasets
  input = '/users/mamana/genotype-imputation/test_sample.csv'
  
  // Alternative if you want to use a different CSV file:
  // input = 'path/to/your/samplesheet.csv'
  
  // Note: target_datasets is NOT used when input is specified
  // target_datasets = []  // Leave empty when using CSV input
  
  // Resource limits - Increased based on trace analysis
  max_memory = 16.GB  // Increased from 8GB for better performance on larger chunks
  max_cpus = 8        // Increased from 4 to allow more parallel processing
  max_time = 24.h     // Increased from 12h for complex imputation tasks

  // Reference panels - using H3Africa v6 panels
  ref_panels = [ 
    [ 'H3AR6x', "/cbio/dbs/refpanels/h3a_reference_panels/version_6/v6hc_s/msavs/V6HC-S_%s_all.v2025.05.msav", "/cbio/dbs/refpanels/h3a_reference_panels/version_6/v6hc_s/bcfs/V6HC-S_%s_all.bcf" ],
    //[ 'H3Av7', "/cbio/dbs/refpanels/h3a_reference_panels/version_7/v7hc_s/msavs/V7HC-S_%s_all.v2025.05.msav", "/cbio/dbs/refpanels/h3a_reference_panels/version_7/v7hc_s/bcfs/V7HC-S_%s_all.bcf" ],
  ]

  // Genetic map for eagle2 - using hg38 genetic map (matches b38 data)
  eagle_genetic_map = "/cbio/dbs/refpanels/h3a_reference_panels/version_6/v6hc_s/map/genetic_map_hg38_withX.txt.gz"

  // Reference genome for QC (using hg38 build)  
  reference_genome  = "/cbio/dbs/gatk/hg38/Homo_sapiens_assembly38.fasta"

  // Processing parameters
  chromosomes = "ALL"  // Process all chromosomes found in the input data
  chunk_size = 25000000    // 25Mb chunks for smaller, more manageable processing
  buffer_size = 1000000   // 1Mb buffer for chunking

  // QC parameters
  site_miss = 0.05       // Site missingness threshold
  hwe = 0.00001         // Hardy-Weinberg equilibrium p-value threshold
  mac = 1               // Minimum allele count
  min_ac = 2            // Minimum alternate allele count
  min_alleles = 2       // Minimum number of alleles
  max_alleles = 2       // Maximum number of alleles (biallelic only)
  maf_thresh = 0.1      // Minor allele frequency threshold
  max_mismatch_rate = 0.1  // Maximum allowed REF/ALT mismatch rate (10%)

  // Phasing parameters
  phasing_method = "eagle"      // Use Eagle2 for phasing
  eagle_pbwt_iters = 2          // PBWT iterations for Eagle

  // Imputation parameters
  impute_method = "minimac4"    // Use Minimac4 for imputation
  NE = 20000                    // Effective population size
  impute_iter = 10              // Imputation iterations
  impute_burnin = 2             // Burn-in iterations
  impute_info_cutoff = 0.3      // Info score cutoff for filtering
  minRatio = 0.001               // Minimac4 minimum ratio parameter
  r2_threshold = 0.3            // R2 threshold for reporting

  // Reporting
  qc_plots = true               // Generate QC plots
  
  // Hierarchical reporting controls - ENABLED FOR THIS TEST RUN
  enable_chunk_reports = true       // Chunk-level plots (enabled for this run)
  enable_chromosome_reports = true  // Chromosome-level aggregated plots (enabled for this run)
  enable_genome_reports = true      // Genome-wide summary plots (enabled by default)

  // Other parameters
  plink = "plink2"              // Use plink2 for processing
  email = null                  // Email for notifications (set if needed)
}

// Pipeline reporting
timeline {
  enabled = true
  file = "${params.outdir}/shared/nextflow_reports/${params.project_name}_h3achipimputation_timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.outdir}/shared/nextflow_reports/${params.project_name}_h3achipimputation_report.html"
  overwrite = true
}
trace {
  enabled = true
  file = "${params.outdir}/shared/nextflow_reports/${params.project_name}_h3achipimputation_trace.txt"
  overwrite = true
}
dag {
  enabled = true
  file = "${params.outdir}/shared/nextflow_reports/${params.project_name}_h3achipimputation_dag.png"
  overwrite = true
}

// Process-specific resource requirements
process {
  // Default settings
  cpus = 1
  memory = 2.GB
  time = 4.h
  
  // Error handling
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries = 2
  maxErrors = '-1'
  
  // Process labels - Updated based on trace analysis
  withLabel: 'process_single' {
    cpus = 1
    memory = 4.GB  // Increased from 4GB
    time = 2.h     // Increased from 2h
  }
  
  withLabel: 'process_low' {
    cpus = 2
    memory = 10.GB  // Increased from 2GB
    time = 2.h     // Increased from 2h
  }
  
  withLabel: 'process_medium' {
    cpus = 5       // Increased from 5
    memory = 50.GB // Increased from 50GB
    time = 2.h     // Increased from 2h
  }
  
  withLabel: 'process_high' {
    cpus = 5       // Increased from 5
    memory = 50.GB // Increased from 50GB
    time = 2.h    // Increased from 2h
  }
  
  // Legacy labels for compatibility - Updated
  withLabel: 'medium' {
    memory = 50.GB  // Increased from 50GB
    cpus = 5       // Increased from 5
  }
  
  withLabel: 'bigmem' {
    memory = 100.GB // Increased from 100GB
    cpus = 10       // Increased from 10
  }
  
  withLabel: 'bigmem1' {
    memory = 120.GB // Increased from 120GB
    cpus = 10       // Increased from 10
  }
  
  withLabel: 'verylarge' {
    memory = 200.GB // Increased from 200GB
    cpus = 20       // Increased from 20
  }
  
  // Specific process overrides
  withName: 'CHECK_FILES' {
    cpus = 1
    memory = 1.GB   // Just checking file existence
    time = 10.m
  }
  
  // Add allocations for overlap checking processes
  withName: 'CHECK_OVERLAP' {
    cpus = 1
    memory = 1.GB   // Trace shows ~3-14 MB usage
    time = 30.m
  }
  
  withName: 'GENERATE_CHUNK_MAP' {
    cpus = 1
    memory = 1.GB   // Trace shows ~1.6 MB usage
    time = 30.m
  }
  
  withName: 'GENERATE_REF_MAP' {
    cpus = 1
    memory = 1.GB   // Trace shows ~12-13 MB usage
    time = 30.m
  }
  
  withName: 'SPLIT_TARGET_TO_CHUNK' {
    cpus = 2        // Actual usage: ~1 CPU (98% of single core)
    memory = 2.GB   // Actual usage: ~15 MB, giving buffer for larger chunks
    time = 2.h      // Most complete in minutes
    maxForks = 50   // Allow many parallel chunk splitting jobs
  }
  
  withName: 'EAGLE_PHASING' {
    cpus = 4        // Eagle typically uses 2-3 CPUs effectively
    memory = 8.GB   // Eagle needs more memory for reference panel
    time = 4.h      // Phasing can take time
    maxForks = 100  // Allow many parallel phasing jobs
    // Exit code 199 indicates chunk should be skipped due to genetic map issues
    // Allow pipeline to continue with other chunks
    errorStrategy = { task.exitStatus == 199 ? 'ignore' : 
                     task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  }
  
  withName: 'IMPUTE_MINIMAC4' {
    cpus = 2        // Uses ~150% CPU (1.5 cores)
    memory = 4.GB   // Minimac4 is memory efficient
    time = 2.h      // Most chunks complete quickly
    maxForks = 100  // Allow many parallel imputation jobs
  }
  
  withName: 'GENERATE_CHUNKS_VCF' {
    cpus = 1        // Single-threaded process
    memory = 4.GB   // Needs memory for VCF processing
    time = 1.h      // Usually quick
  }
  
  // Additional process-specific allocations based on trace analysis
  withName: 'QC_DUPL' {
    cpus = 1
    memory = 2.GB   // VCF QC processes are lightweight
    time = 1.h
    maxForks = 50   // Allow parallel QC processing
  }
  
  withName: 'SPLIT_MULTI_ALLELIC' {
    cpus = 1
    memory = 2.GB   // Simple VCF operation
    time = 1.h
    maxForks = 50   // Allow parallel processing
  }
  
  withName: 'FILTER_MIN_AC' {
    cpus = 1
    memory = 2.GB   // Filtering is memory efficient
    time = 1.h
    maxForks = 50   // Allow parallel filtering
  }
  
  // TARGET_QC removed - process is temporarily disabled in preprocess.nf
  // withName: 'TARGET_QC' {
  //   cpus = 2
  //   memory = 4.GB   // May need more for statistics calculation
  //   time = 1.h
  // }
  
  // Reporting processes - match actual module names
  withName: 'PLOT_PERFORMANCE|PLOT_ACCURACY|PLOT_R2_MAF|PLOT_FREQ_COMPARISON|PLOT_R2_SNPPOS|PLOT_R2_SNPCOUNT|PLOT_HIST_R2_SNPCOUNT|PLOT_MAF_R2' {
    cpus = 2
    memory = 10.GB   // Plotting can be memory intensive
    time = 2.h
  }
  
  // Dosage distribution plotting - needs more memory for large VCF files
  withName: 'PLOT_DOSAGE_DISTRIBUTION|PLOT_DOSAGE_DISTRIBUTION_CHUNK' {
    cpus = 5
    memory = 50.GB   // Increased to 50GB to handle large imputed VCF files
    time = 3.h
    errorStrategy = { task.exitStatus in [137] ? 'retry' : 'finish' }
    maxRetries = 2
  }
  
  // Frequency extraction processes
  withName: 'EXTRACT_FREQ_IMPUTED|EXTRACT_FREQ_REFERENCE|MERGE_FREQ_COMPARISON' {
    cpus = 5
    memory = 50.GB
    time = 2.h
  }
}

// Execution profiles
profiles {
  // Standard local execution
  standard {
    process.executor = 'local'
  }
  
  // Singularity containers
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = "-B ${HOME} -B /cbio -B /scratch3 -B /users"
    singularity.cacheDir = './singularity_cache'
    
    process {
      container = 'mamana/imputation:minimac4-4.1.6'
      
      withLabel: 'bcftools' {
        container = 'mamana/vcf-processing:bcftools-1.20'
      }
      
      withLabel: 'phasing_eagle' {
        container = 'mamana/eagle-vcf-processing:eagle-2.4.1'
      }
      
      withLabel: 'impute_minimac4' {
        container = 'mamana/minimac4:minimac4-4.1.6'
      }
      
      withLabel: 'python_plotting' {
        container = 'mamana/python-plotting:1.1.0'
      }
      
      withLabel: 'latex_reporting' {
        container = 'mamana/chipimputation-latex-reporting:1.0.0'
        memory = 8.GB
        cpus = 2
      }
    }
  }
  
  // SLURM cluster execution
  slurm {
    process.executor = 'slurm'
    process.queue = 'Main'  // Use Main partition (default on this cluster)
    // process.clusterOptions = '--account=cbio'  // Uncomment if account is needed
    executor.name = 'slurm'  // Explicitly set executor name
    executor.queueSize = 500  // Increased to allow many more parallel jobs
    executor.submitRateLimit = '200/1min'  // Increased to 200 jobs/min for faster submission
    // Additional SLURM options to ensure job submission
    process.beforeScript = 'echo "Job started on $(hostname) at $(date)"'
  }
  
  // Test profile
  test {
    executor.queueSize = 20  // Increased from 5 for faster test runs
    params.max_memory = 4.GB
    params.max_cpus = 2
    params.max_time = 2.h
  }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Export functions for pipeline manifest
manifest {
  name = 'h3abionet/chipimputation'
  author = 'H3ABioNet Consortium'
  homePage = 'https://github.com/h3abionet/chipimputation'
  description = 'H3Africa genotype imputation pipeline - nf-core style with CSV input'
  mainScript = 'main_nfcore.nf'
  nextflowVersion = '>=21.04.0'
  version = '1.0.0'
}