/*
 * -------------------------------------------------
 *  Nextflow config file for v6 chr21/22 phased imputation - nf-core style
 * -------------------------------------------------
 * Configuration for imputing v6 phased data with H3Africa reference panels
 * Uses CSV samplesheet input instead of target_datasets
 * Compatible with main_nfcore.nf
 */

// Set work directory to scratch for better performance
workDir = '/scratch3/users/mamana/nextflow-work'

params {
  // Project information
  project_name            = 'v6_chr21_phased_imputation_nfcore'
  project_description     = 'Imputation test using v6 chr21/22 phased data with CSV input'
  outDir                  = "output/${project_name}"
  help                    = false
  version                 = '1.0.0'
  
  // Input - using CSV samplesheet instead of target_datasets
  input = '/users/mamana/genotype-imputation/test_sample.csv'
  
  // Alternative if you want to use a different CSV file:
  // input = 'path/to/your/samplesheet.csv'
  
  // Note: target_datasets is NOT used when input is specified
  // target_datasets = []  // Leave empty when using CSV input
  
  // Resource limits
  max_memory = 8.GB
  max_cpus = 4
  max_time = 12.h

  // Reference panels - using H3Africa v6 panels
  ref_panels = [ 
    [ 'H3AR6x', "/cbio/dbs/refpanels/h3a_reference_panels/version_6/v6hc_s/msavs/V6HC-S_%s_all.v2025.05.msav", "/cbio/dbs/refpanels/h3a_reference_panels/version_6/v6hc_s/bcfs/V6HC-S_%s_all.bcf" ],
  ]

  // Genetic map for eagle2 - using H3Africa genetic map
  eagle_genetic_map = "/cbio/dbs/refpanels/eagle/tables/genetic_map_hg19_withX.txt.gz"

  // Reference genome for QC (using hg38 build)  
  reference_genome  = "/cbio/dbs/gatk/hg38/Homo_sapiens_assembly38.fasta"

  // Processing parameters
  chromosomes = "ALL"  // Process all chromosomes found in the input data
  chunk_size = 1000000    // 1Mb chunks for smaller, more manageable processing
  buffer_size = 500000   // 500kb buffer for chunking

  // QC parameters
  site_miss = 0.05       // Site missingness threshold
  hwe = 0.00001         // Hardy-Weinberg equilibrium p-value threshold
  mac = 1               // Minimum allele count
  min_ac = 2            // Minimum alternate allele count
  min_alleles = 2       // Minimum number of alleles
  max_alleles = 2       // Maximum number of alleles (biallelic only)
  maf_thresh = 0.1      // Minor allele frequency threshold
  max_mismatch_rate = 0.1  // Maximum allowed REF/ALT mismatch rate (10%)

  // Phasing parameters
  phasing_method = "eagle"      // Use Eagle2 for phasing
  eagle_pbwt_iters = 2          // PBWT iterations for Eagle

  // Imputation parameters
  impute_method = "minimac4"    // Use Minimac4 for imputation
  NE = 20000                    // Effective population size
  impute_iter = 10              // Imputation iterations
  impute_burnin = 2             // Burn-in iterations
  impute_info_cutoff = 0.3      // Info score cutoff for filtering
  minRatio = 0.001               // Minimac4 minimum ratio parameter
  r2_threshold = 0.3            // R2 threshold for reporting

  // Reporting
  qc_plots = true               // Generate QC plots

  // Other parameters
  plink = "plink2"              // Use plink2 for processing
  email = null                  // Email for notifications (set if needed)
}

// Pipeline reporting
timeline {
  enabled = true
  file = "${params.outDir}/nextflow_reports/${params.project_name}_h3achipimputation_timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.outDir}/nextflow_reports/${params.project_name}_h3achipimputation_report.html"
  overwrite = true
}
trace {
  enabled = true
  file = "${params.outDir}/nextflow_reports/${params.project_name}_h3achipimputation_trace.txt"
  overwrite = true
}
dag {
  enabled = true
  file = "${params.outDir}/nextflow_reports/${params.project_name}_h3achipimputation_dag.png"
  overwrite = true
}

// Process-specific resource requirements
process {
  // Default settings
  cpus = 1
  memory = 2.GB
  time = 4.h
  
  // Error handling
  errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  maxRetries = 2
  maxErrors = '-1'
  
  // Process labels
  withLabel: 'process_single' {
    cpus = 1
    memory = 2.GB
    time = 2.h
  }
  
  withLabel: 'process_low' {
    cpus = 2
    memory = 4.GB
    time = 4.h
  }
  
  withLabel: 'process_medium' {
    cpus = 2
    memory = 4.GB
    time = 6.h
  }
  
  withLabel: 'process_high' {
    cpus = 4
    memory = 8.GB
    time = 8.h
  }
  
  // Legacy labels for compatibility
  withLabel: 'medium' {
    memory = 2.GB
    cpus = 2
  }
  
  withLabel: 'bigmem' {
    memory = 4.GB
    cpus = 2
  }
  
  withLabel: 'bigmem1' {
    memory = 4.GB
    cpus = 2
  }
  
  withLabel: 'verylarge' {
    memory = 6.GB
    cpus = 3
  }
  
  // Specific process overrides
  withName: 'CHECK_FILES' {
    cpus = 1
    memory = 1.GB
    time = 1.h
  }
  
  withName: 'EAGLE_PHASING' {
    cpus = 4
    memory = 8.GB
    time = 6.h
    // Exit code 199 indicates chunk should be skipped due to genetic map issues
    // Allow pipeline to continue with other chunks
    errorStrategy = { task.exitStatus == 199 ? 'ignore' : 
                     task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
  }
  
  withName: 'IMPUTE_MINIMAC4' {
    cpus = 2
    memory = 4.GB
    time = 4.h
  }
  
  withName: 'GENERATE_CHUNKS_VCF' {
    cpus = 2
    memory = 4.GB
    time = 2.h
  }
}

// Execution profiles
profiles {
  // Standard local execution
  standard {
    process.executor = 'local'
  }
  
  // Singularity containers
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.runOptions = "-B ${HOME} -B /cbio -B /scratch3 -B /users"
    singularity.cacheDir = './singularity_cache'
    
    process {
      container = 'mamana/imputation:minimac4-4.1.6'
      
      withLabel: 'bcftools' {
        container = 'mamana/vcf-processing:bcftools-1.20'
      }
      
      withLabel: 'phasing_eagle' {
        container = 'mamana/eagle-vcf-processing:eagle-2.4.1'
      }
      
      withLabel: 'impute_minimac4' {
        container = 'mamana/minimac4:minimac4-4.1.6'
      }
      
      withLabel: 'python_plotting' {
        container = 'mamana/python-plotting:1.0.0'
      }
    }
  }
  
  // SLURM cluster execution
  slurm {
    process.executor = 'slurm'
    process.queue = 'Main'  // Use Main partition (default on this cluster)
    // process.clusterOptions = '--account=cbio'  // Uncomment if account is needed
    queueSize = 5
  }
  
  // Test profile
  test {
    queueSize = 5
    params.max_memory = 4.GB
    params.max_cpus = 2
    params.max_time = 2.h
  }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Export functions for pipeline manifest
manifest {
  name = 'h3abionet/chipimputation'
  author = 'H3ABioNet Consortium'
  homePage = 'https://github.com/h3abionet/chipimputation'
  description = 'H3Africa genotype imputation pipeline - nf-core style with CSV input'
  mainScript = 'main_nfcore.nf'
  nextflowVersion = '>=21.04.0'
  version = '1.0.0'
}