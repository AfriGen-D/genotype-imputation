/*
========================================================================================
    Genotype Imputation Pipeline v2.0 - Main Configuration
========================================================================================
*/

// Pipeline version
manifest {
    name            = 'genotype-imputation'
    author          = 'H3ABioNet'
    homePage        = 'https://github.com/h3abionet/chipimputation'
    description     = 'Nextflow pipeline for genotype imputation - v2.0 refactored'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '2.0.0'
}

// Set work directory to scratch
workDir = '/scratch3/users/mamana/nextflow-work'

// Global parameters
params {
    // Input/output options
    input                      = null
    outdir                     = './results'
    outDir                     = './output'  // Legacy compatibility
    publish_dir_mode           = 'copy'
    
    // Reference genome options
    genome                     = null
    genome_build               = 'b38' // 'b37' or 'b38'
    reference_panels           = []
    ref_panels                 = []  // Legacy compatibility
    eagle_genetic_map          = "/cbio/dbs/refpanels/eagle/tables/genetic_map_hg19_withX.txt.gz"
    reference_genome           = "/cbio/dbs/gatk/hg38/Homo_sapiens_assembly38.fasta"
    chromosomes                = 'ALL'
    
    // QC options
    qc_min_ac                  = 2
    qc_min_maf                 = 0.01
    qc_max_missing             = 0.05
    qc_hwe_pvalue              = 1e-6
    remove_duplicates          = true
    split_multiallelic         = true
    
    // Legacy QC parameters for compatibility
    min_ac                     = 2
    site_miss                  = 0.05
    site_missingness           = 0.05
    hwe                        = 0.00001
    mac                        = 1
    maf_thresh                 = 0.1
    max_mismatch_rate          = 0.1
    r2_threshold               = 0.3
    
    // Performance optimization flags
    skip_missingness_calc      = true   // Skip detailed missingness calculations
    skip_hwe_check            = true   // Skip Hardy-Weinberg equilibrium check
    skip_annotation           = true   // Skip variant annotation
    minimal_qc_mode           = true   // Run only essential QC steps
    
    // Validation options (to speed up pipeline)
    skip_vcf_stats             = true   // Skip detailed VCF statistics in validation
    skip_chr_validation        = true   // Skip chromosome validation check
    skip_ref_compatibility     = true   // Skip reference compatibility check
    skip_sample_overlap        = true   // Skip sample overlap check
    
    // Chunking options for parallel processing
    enable_chunking            = true    // Enable VCF chunking for parallel processing
    chunk_size                 = 5000000  // Genomic region size in base pairs (5 Mb)
    buffer_size                = 1000000  // Buffer size for chunking in base pairs
    overlap_min_ratio          = 0.00001  // Minimum overlap ratio for chunks
    chunk                      = ''        // Specific chunk to process
    
    // Phasing options
    phasing_tool               = 'eagle' // 'eagle', 'shapeit', or 'beagle'
    phasing_method             = 'eagle' // Legacy compatibility
    eagle_pbwt_iters           = 2
    
    // Imputation options
    imputation_tool            = 'minimac4' // 'minimac4', 'impute5', or 'beagle5'
    impute_method              = 'minimac4' // Legacy compatibility
    impute_info_cutoff         = 0.3
    impute_window              = 500000
    impute_ne                  = 20000
    impute_buffer              = 250000
    impute_iter                = 10
    impute_burnin              = 2
    NE                         = 20000  // Legacy compatibility
    minRatio                   = '0.01'
    
    // Reporting options
    report_level               = 'detailed' // 'summary', 'detailed', or 'full'
    generate_plots             = true
    qc_plots                   = true
    concordance_analysis       = false
    aggregate_reports          = true
    generate_chunk_plots       = false
    r2_window_size            = 1000000
    
    // Hierarchical reporting controls
    enable_chunk_reports       = false      // Generate chunk-level plots
    enable_chromosome_reports  = false      // Generate chromosome-level plots
    enable_genome_reports      = true       // Generate genome-wide plots
    
    // Computational resources
    max_cpus                   = 16
    max_memory                 = '128.GB'
    max_time                   = '240.h'
    
    // Project options
    project_name               = "h3achipimputation"
    name                       = false
    version                    = '1.0'
    
    // Boilerplate options
    help                       = false
    email                      = null
    plaintext_email            = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = 'genomes,modules'
    hostnames                  = false
    config_profile_description = false
    config_profile_contact     = false
    config_profile_url         = false
    clusterOptions             = false
    
    // Trace directory
    tracedir                   = "${params.outdir}/pipeline_info"
    
    // Legacy v1.x parameter mappings
    target_datasets            = null  // Maps to 'input'
}

// Load additional configs
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Container configuration
process {
    container = 'mamana/imputation:minimac4-4.1.6'
    
    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries = 3
    maxErrors = '-1'
    
    // Process labels for resources
    withLabel: 'process_single' {
        cpus = 1
        memory = 2.GB
        time = 2.h
    }
    
    withLabel: 'process_low' {
        cpus = 2
        memory = 4.GB
        time = 4.h
    }
    
    withLabel: 'process_medium' {
        cpus = 4
        memory = 8.GB
        time = 8.h
    }
    
    withLabel: 'process_high' {
        cpus = 8
        memory = 16.GB
        time = 12.h
    }
    
    withLabel: 'process_long' {
        time = 24.h
    }
    
    withLabel: 'process_high_memory' {
        memory = 32.GB
    }
    
    // Legacy labels for compatibility
    withLabel: 'small' {
        cpus = 1
        memory = 2.GB
        time = 2.h
    }
    
    withLabel: 'medium' {
        cpus = 2
        memory = 4.GB
        time = 4.h
    }
    
    withLabel: 'bigmem' {
        cpus = 4
        memory = 8.GB
        time = 8.h
    }
    
    withLabel: 'bigmem1' {
        cpus = 4
        memory = 8.GB
        time = 8.h
    }
    
    withLabel: 'bigmem10' {
        cpus = 8
        memory = 16.GB
        time = 12.h
    }
    
    withLabel: 'verylarge' {
        cpus = 8
        memory = 32.GB
        time = 24.h
    }
    
    // Container assignments
    withLabel: 'impute_minimac4' {
        container = 'mamana/minimac4:minimac4-4.1.6'
    }
    
    withLabel: 'phasing_eagle' {
        container = 'mamana/eagle-vcf-processing:eagle-2.4.1'
    }
    
    withLabel: 'bcftools' {
        container = 'mamana/vcf-processing:bcftools-1.20'
    }
    
    withLabel: 'python_plotting' {
        container = 'mamana/python-plotting:1.1.0'
    }
    
    // LaTeX report generation processes
    withLabel: 'latex_reporting' {
        container = 'mamana/chipimputation-latex-reporting:1.0.0'
        memory = 8.GB
        cpus = 2
    }
    
    // Specific process overrides for OOM issues
    withName: 'PLOT_DOSAGE_DISTRIBUTION|PLOT_DOSAGE_DISTRIBUTION_CHUNK' {
        cpus = 5
        memory = 50.GB   // Increased to handle large imputed VCF files
        time = 3.h
        errorStrategy = { task.exitStatus in [137] ? 'retry' : 'finish' }
        maxRetries = 2
    }
}

// Execution profiles
profiles {
    standard {
        docker.enabled = false
        singularity.enabled = false
    }
    
    docker {
        docker.enabled = true
        docker.userEmulation = true
        docker.runOptions = '-u root'
        docker.fixOwnership = true
        singularity.enabled = false
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.pullTimeout = '60m'
        singularity.cacheDir = './singularity_cache'
        singularity.runOptions = "-B ${HOME} -B /cbio -B /scratch3"
        docker.enabled = false
    }
    
    slurm {
        process.executor = 'slurm'
        process.queue = 'Main'
        singularity.enabled = true
        singularity.autoMounts = true
    }
    
    test {
        includeConfig 'conf/test.config'
    }
    
    test_full {
        includeConfig 'conf/test_full.config'
    }
    
    test_local {
        includeConfig 'conf/test.config'
        process.container = null
        docker.enabled = false
        singularity.enabled = false
    }
    
    // Legacy profiles for backward compatibility
    cbio {
        includeConfig 'conf/test_cbio.config'
    }
    
    debug {
        process.beforeScript = 'echo $HOSTNAME'
    }
    
    conda {
        process.conda = "$baseDir/environment.yml"
    }
}

// Capture exit codes
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Execution tracing
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

// Function to handle legacy parameters
def checkLegacyParams() {
    // Map old parameters to new ones
    if (params.target_datasets && !params.input) {
        params.input = params.target_datasets
    }
    if (params.ref_panels && !params.reference_panels) {
        params.reference_panels = params.ref_panels
    }
    if (params.outDir && !params.outdir) {
        params.outdir = params.outDir
    }
    if (params.site_miss && !params.qc_max_missing) {
        params.qc_max_missing = params.site_miss
    }
    if (params.hwe && !params.qc_hwe_pvalue) {
        params.qc_hwe_pvalue = params.hwe
    }
    if ((params.mac || params.min_ac) && !params.qc_min_ac) {
        params.qc_min_ac = params.mac ?: params.min_ac
    }
    if (params.NE && !params.impute_ne) {
        params.impute_ne = params.NE
    }
    if (params.buffer_size && !params.impute_buffer) {
        params.impute_buffer = params.buffer_size
    }
}

// Check for legacy parameters on startup
checkLegacyParams()